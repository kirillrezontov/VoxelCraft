execute_process(COMMAND "${CMAKE_COMMAND}" -S "${VC_FIXTURE}" -B "${VC_BINARY}"
    "-DVC_BOUNDARIES_FILE=${VC_BOUNDARIES_FILE}" "-DVC_CASE=${VC_CASE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(VC_CASE STREQUAL "valid")
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Valid graph rejected: ${output}${error}")
    endif()
else()
    if(VC_CASE STREQUAL "cycle")
        set(expected "Module dependency cycle")
    elseif(VC_CASE STREQUAL "graphics")
        set(expected "Forbidden graphics dependency")
    else()
        set(expected "Forbidden module dependency")
    endif()
    string(FIND "${output}${error}" "${expected}" found)
    if(status EQUAL 0 OR found LESS 0)
        message(FATAL_ERROR "Expected ${expected}; got ${status}: ${output}${error}")
    endif()
endif()
