# Validate project target links at configure time. Inspect both usage and link
# implementation edges: PRIVATE static-library dependencies still reach binaries.
function(vc_walk_module target stack forbidden)
    if(target IN_LIST stack)
        message(FATAL_ERROR "Module dependency cycle: ${stack};${target}")
    endif()
    if(target IN_LIST forbidden)
        message(FATAL_ERROR "Forbidden module dependency: ${stack};${target}")
    endif()
    if(target MATCHES "^(SDL3::|Vulkan::|VoxelUI::)")
        if("graphics" IN_LIST forbidden)
            message(FATAL_ERROR "Forbidden graphics dependency: ${stack};${target}")
        endif()
    endif()
    if(NOT target MATCHES "^(vc_|voxelcraft)" OR NOT TARGET "${target}")
        return()
    endif()
    list(APPEND stack "${target}")
    get_target_property(implementation "${target}" LINK_LIBRARIES)
    get_target_property(interface "${target}" INTERFACE_LINK_LIBRARIES)
    set(edges ${implementation} ${interface})
    list(REMOVE_DUPLICATES edges)
    foreach(edge IN LISTS edges)
        # CMake wraps private static links when propagating them to consumers.
        string(REGEX REPLACE "^\\$<LINK_ONLY:([^>]+)>$" "\\1" edge "${edge}")
        if(edge MATCHES "\\$<")
            message(FATAL_ERROR "Module checker needs an explicit rule for link expression: ${target} -> ${edge}")
        endif()
        vc_walk_module("${edge}" "${stack}" "${forbidden}")
    endforeach()
endfunction()

function(vc_validate_module_boundaries)
    get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        if(target MATCHES "^(vc_|voxelcraft)")
            vc_walk_module("${target}" "" "")
        endif()
    endforeach()
    foreach(target vc_voxel vc_generation vc_lighting vc_meshing vc_storage vc_gameplay vc_content vc_simulation)
        if(TARGET "${target}")
            vc_walk_module("${target}" "" "graphics;vc_lua;vc_modding;vc_platform;vc_input;vc_renderer;vc_game_ui;vc_ui_core")
        endif()
    endforeach()
    foreach(target vc_server_host voxelcraft_server)
        if(TARGET "${target}")
            vc_walk_module("${target}" "" "graphics;vc_platform;vc_input;vc_renderer;vc_game_ui;vc_ui_core;vc_meshing;vc_lighting")
        endif()
    endforeach()
endfunction()
