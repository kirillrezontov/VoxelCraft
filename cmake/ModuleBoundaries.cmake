# Inspect actual project target links, including private static-library links.
# Both configuration and the build fail if a future edit introduces these edges.
function(vc_visit_module target path forbidden)
    if(target IN_LIST path)
        message(FATAL_ERROR "Core module dependency cycle: ${path};${target}")
    endif()
    if(target IN_LIST forbidden)
        message(FATAL_ERROR "Forbidden module dependency: ${path};${target}")
    endif()
    list(APPEND path "${target}")
    get_target_property(kind ${target} TYPE)
    if(kind STREQUAL "INTERFACE_LIBRARY")
        get_target_property(links ${target} INTERFACE_LINK_LIBRARIES)
    else()
        get_target_property(links ${target} LINK_LIBRARIES)
    endif()
    foreach(link IN LISTS links)
        if(link MATCHES "^vc_" AND TARGET ${link})
            get_target_property(aliased ${link} ALIASED_TARGET)
            if(aliased)
                set(link "${aliased}")
            endif()
            vc_visit_module("${link}" "${path}" "${forbidden}")
        endif()
    endforeach()
endfunction()

function(vc_check_module_boundaries)
    get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        if(target MATCHES "^vc_" OR target MATCHES "^voxelcraft")
            vc_visit_module("${target}" "" "")
        endif()
    endforeach()
    # These mechanisms cannot acquire game policy, UI, Lua or GPU ownership.
    set(cpu_forbidden vc_gameplay vc_content vc_game_content vc_modding vc_lua
        vc_game_ui vc_ui_core vc_renderer vc_platform vc_input vc_client_runtime)
    foreach(target vc_voxel vc_generation vc_streaming vc_lighting vc_meshing vc_physics vc_storage vc_network)
        vc_visit_module("${target}" "" "${cpu_forbidden}")
    endforeach()
    vc_visit_module(vc_voxel "" "vc_generation;vc_streaming;vc_lighting;vc_meshing;vc_physics;vc_storage;vc_render_data")
    vc_visit_module(vc_protocol "" "vc_modding;vc_lua;vc_game_content;vc_renderer;vc_platform;vc_input")
    if(TARGET vc_server_host)
        vc_visit_module(vc_server_host "" "vc_renderer;vc_platform;vc_input;vc_game_ui;vc_ui_core;vc_meshing")
    endif()
endfunction()
