# Explicit source checkout or exact installed package. No implicit sibling lookup,
# network clone, source copying, or dependency on a moving branch.
set(VC_VOXELUI_SOURCE_DIR "" CACHE PATH "Explicit VoxelUI checkout (e.g. ../VoxelUI); empty uses installed 0.2.1 package")
if(VC_VOXELUI_SOURCE_DIR)
    get_filename_component(vc_voxelui_source "${VC_VOXELUI_SOURCE_DIR}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
    if(NOT EXISTS "${vc_voxelui_source}/include/voxelui/vulkan.hpp")
        message(FATAL_ERROR "VC_VOXELUI_SOURCE_DIR must contain the Vulkan-capable VoxelUI source checkout")
    endif()
    set(VOXELUI_VULKAN ON)
    set(VOXELUI_PREVIEW_SDL OFF)
    set(VOXELUI_TESTS OFF)
    set(VOXELUI_VULKAN_TESTS OFF)
    add_subdirectory("${vc_voxelui_source}" "${CMAKE_CURRENT_BINARY_DIR}/voxelui" EXCLUDE_FROM_ALL)
else()
    find_package(VoxelUI 0.2.1 EXACT CONFIG REQUIRED COMPONENTS vulkan)
endif()
if(NOT TARGET VoxelUI::vulkan)
    message(FATAL_ERROR "VoxelUI must provide its optional VoxelUI::vulkan target")
endif()
