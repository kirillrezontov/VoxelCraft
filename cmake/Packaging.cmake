# Archives contain only game components, never upstream development installs.
set(CPACK_PACKAGE_NAME VoxelCraft)
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}-rc1")
set(CPACK_PACKAGE_VENDOR VoxelCraft)
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "VoxelCraft multiplayer preview release candidate")
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}/packages")
set(CPACK_ARCHIVE_COMPONENT_INSTALL ON)
set(CPACK_COMPONENTS_GROUPING IGNORE)
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_COMPONENT_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_COMPONENTS_ALL)
if(WIN32)
    set(CPACK_GENERATOR ZIP)
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
    include(InstallRequiredSystemLibraries)
else()
    set(CPACK_GENERATOR TGZ)
endif()
set(vc_package_base "VoxelCraft-${PROJECT_VERSION}-rc1-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(vc_runtime_baseline "Windows 10 1903+ and Vulkan 1.3 driver for client")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    execute_process(COMMAND getconf GNU_LIBC_VERSION OUTPUT_VARIABLE vc_runtime_baseline
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/package-build-info-$<CONFIG>.txt"
    CONTENT "VoxelCraft ${PROJECT_VERSION}-rc1\nPlatform: ${CMAKE_SYSTEM_NAME} ${CMAKE_SYSTEM_PROCESSOR}\nCompiler: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\nConfiguration: $<CONFIG>\nRuntime build baseline: ${vc_runtime_baseline}\nWorld format: 1; player versions: 1..10; mod API: 1; network protocol: 4\n")
set(vc_license_dir "${CMAKE_CURRENT_BINARY_DIR}/package-licenses")
file(MAKE_DIRECTORY "${vc_license_dir}")
function(vc_license source name)
    if(EXISTS "${source}")
        configure_file("${source}" "${vc_license_dir}/${name}" COPYONLY)
    endif()
endfunction()
vc_license("${PROJECT_SOURCE_DIR}/assets/fonts/LICENSE-DejaVu.txt" DejaVu.txt)
file(READ "${PROJECT_SOURCE_DIR}/third_party/stb/stb_truetype.h" vc_truetype_header)
string(FIND "${vc_truetype_header}" "ALTERNATIVE A - MIT License" vc_truetype_license_start)
if(vc_truetype_license_start LESS 0)
    message(FATAL_ERROR "Cannot locate vendored stb_truetype license")
endif()
string(SUBSTRING "${vc_truetype_header}" ${vc_truetype_license_start} -1 vc_truetype_license)
file(WRITE "${vc_license_dir}/stb_truetype.txt" "${vc_truetype_license}")
vc_license("${glm_SOURCE_DIR}/copying.txt" GLM.txt)
vc_license("${entt_SOURCE_DIR}/LICENSE" EnTT.txt)
vc_license("${nlohmann_json_SOURCE_DIR}/LICENSE.MIT" JSON.txt)
vc_license("${lua_SOURCE_DIR}/doc/readme.html" Lua.html)
vc_license("${sdl3_SOURCE_DIR}/LICENSE.txt" SDL.txt)
if(EXISTS "${stb_image_SOURCE_DIR}/stb_image.h")
    file(READ "${stb_image_SOURCE_DIR}/stb_image.h" vc_stb_header)
    string(FIND "${vc_stb_header}" "ALTERNATIVE A - MIT License" vc_stb_license_start)
    if(vc_stb_license_start LESS 0)
        message(FATAL_ERROR "Cannot locate pinned stb_image license")
    endif()
    string(SUBSTRING "${vc_stb_header}" ${vc_stb_license_start} -1 vc_stb_license)
    file(WRITE "${vc_license_dir}/stb_image.txt" "${vc_stb_license}")
endif()

foreach(component Client Server)
    if(component STREQUAL "Client")
        if(NOT VC_BUILD_CLIENT)
            continue()
        endif()
        set(executable voxelcraft)
        install(FILES ${shader_outputs} DESTINATION assets/shaders COMPONENT Client)
        install(DIRECTORY "${PROJECT_SOURCE_DIR}/assets/fonts/" DESTINATION assets/fonts COMPONENT Client)
        install(DIRECTORY "${PROJECT_SOURCE_DIR}/assets/resources/" DESTINATION assets/resources COMPONENT Client)
    else()
        if(NOT VC_BUILD_SERVER)
            continue()
        endif()
        set(executable voxelcraft_server)
    endif()
    list(APPEND CPACK_COMPONENTS_ALL ${component})
    string(TOLOWER "${component}" vc_lower_component)
    string(TOUPPER "${component}" vc_upper_component)
    set(CPACK_ARCHIVE_${vc_upper_component}_FILE_NAME "${vc_package_base}-${vc_lower_component}")
    set_target_properties(${executable} PROPERTIES INSTALL_RPATH "$ORIGIN/lib")
    install(TARGETS ${executable} RUNTIME_DEPENDENCY_SET ${component}Runtime
        RUNTIME DESTINATION . COMPONENT ${component})
    if(WIN32)
        install(RUNTIME_DEPENDENCY_SET ${component}Runtime
            PRE_EXCLUDE_REGEXES "api-ms-" "ext-ms-" "[Vv]ulkan-1\\.dll"
            POST_EXCLUDE_REGEXES ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\][Ss][Yy][Ss][Tt][Ee][Mm]32.*" ".*[Vv]ulkan-1\\.dll"
            RUNTIME DESTINATION . COMPONENT ${component})
        if(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
            install(PROGRAMS ${CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS} DESTINATION . COMPONENT ${component})
        endif()
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        install(RUNTIME_DEPENDENCY_SET ${component}Runtime
            POST_EXCLUDE_REGEXES ".*/(libc|libm|libpthread|libdl|librt|libvulkan|ld-linux[^/]*)\\.so.*"
            LIBRARY DESTINATION lib COMPONENT ${component})
    endif()
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}/package-build-info-$<CONFIG>.txt" DESTINATION . RENAME BUILD-INFO.txt COMPONENT ${component})
    install(FILES "${PROJECT_SOURCE_DIR}/packaging/README.txt" DESTINATION . COMPONENT ${component})
    install(FILES "${PROJECT_SOURCE_DIR}/docs/multiplayer.md" "${PROJECT_SOURCE_DIR}/docs/world-format.md"
        "${PROJECT_SOURCE_DIR}/docs/v0.8.2-release-notes.md" "${PROJECT_SOURCE_DIR}/docs/v0.8.2-commands.md"
        "${PROJECT_SOURCE_DIR}/docs/v0.8.2-ui-design.md" "${PROJECT_SOURCE_DIR}/docs/v0.8.2-implementation.md"
        DESTINATION docs COMPONENT ${component})
    install(DIRECTORY "${PROJECT_SOURCE_DIR}/examples/mods" "${PROJECT_SOURCE_DIR}/examples/data_mods" DESTINATION examples COMPONENT ${component})
    install(FILES "${PROJECT_SOURCE_DIR}/docs/native-modding.md" DESTINATION docs COMPONENT ${component})
    if(component STREQUAL "Client")
        install(DIRECTORY "${PROJECT_SOURCE_DIR}/examples/resource_packs" DESTINATION examples COMPONENT Client)
    endif()
    install(DIRECTORY "${vc_license_dir}/" "${PROJECT_SOURCE_DIR}/packaging/licenses/" DESTINATION licenses COMPONENT ${component})
    if(EXISTS "${sdl3_SOURCE_DIR}/src" AND component STREQUAL "Client")
        file(GLOB_RECURSE vc_sdl_licenses LIST_DIRECTORIES FALSE "${sdl3_SOURCE_DIR}/src/*LICENSE*" "${sdl3_SOURCE_DIR}/src/*COPYING*")
        foreach(notice IN LISTS vc_sdl_licenses)
            file(RELATIVE_PATH relative_notice "${sdl3_SOURCE_DIR}/src" "${notice}")
            get_filename_component(relative_directory "${relative_notice}" DIRECTORY)
            install(FILES "${notice}" DESTINATION "licenses/SDL-components/${relative_directory}" COMPONENT ${component})
        endforeach()
    endif()
endforeach()
include(CPack)
